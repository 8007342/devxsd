{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devxsd-gamejam",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/leaderboard.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD",
        "class_name": "Leaderboard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Leaderboard"
      ]
    }
  ]
}
